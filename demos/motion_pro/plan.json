{
 "captions": [
  {
   "start": 0.15,
   "end": 1.69,
   "text": "Claude Codeпен монтаждаған"
  },
  {
   "start": 1.69,
   "end": 2.79,
   "text": "өте оңай."
  },
  {
   "start": 2.79,
   "end": 5.03,
   "text": "Өйткені сіз промпт жіберіп"
  },
  {
   "start": 5.03,
   "end": 7.17,
   "text": "немесе түрлі скилдарды жіберіп"
  },
  {
   "start": 7.17,
   "end": 9.39,
   "text": "немесе түрлі нұсқаулықтарды жіберіп жүрмейсіз."
  },
  {
   "start": 9.39,
   "end": 10.53,
   "text": "Тек қана осындай мен сияқты"
  },
  {
   "start": 10.53,
   "end": 11.83,
   "text": "сөйлеп тұрған қарапайым видеоны"
  },
  {
   "start": 11.83,
   "end": 13.67,
   "text": "жіберсеңіз Telegram ботқа"
  },
  {
   "start": 13.67,
   "end": 16.43,
   "text": "барлығын өзі жасап беретін болады."
  },
  {
   "start": 16.43,
   "end": 17.95,
   "text": "Ол жерге ешқандай артық"
  },
  {
   "start": 17.95,
   "end": 19.39,
   "text": "түсініксіз керек емес."
  },
  {
   "start": 19.39,
   "end": 20.15,
   "text": "Түсінікті ғой я."
  },
  {
   "start": 20.15,
   "end": 20.75,
   "text": "Сондықтан да осындай"
  },
  {
   "start": 20.75,
   "end": 22.35,
   "text": "Telegram ботпен жұмыс жасаймын."
  },
  {
   "start": 22.35,
   "end": 23.91,
   "text": "Telegram ботпен постоянно"
  },
  {
   "start": 23.91,
   "end": 24.65,
   "text": "жұмыс жасағым келеді"
  },
  {
   "start": 24.65,
   "end": 25.59,
   "text": "деп естіп отырсам,"
  },
  {
   "start": 25.59,
   "end": 26.55,
   "text": "астына комментарияға"
  },
  {
   "start": 26.55,
   "end": 28.11,
   "text": "Telegram бот деп жазыңыздар."
  },
  {
   "start": 28.11,
   "end": 29.889,
   "text": "Барлығыңыз осындай Telegram ботқа"
  },
  {
   "start": 29.889,
   "end": 32.03,
   "text": "жұмыс жасауға мүмкіндік беретін боламыз."
  },
  {
   "start": 32.03,
   "end": 33.13,
   "text": "Әрине, бұл тегін емес."
  },
  {
   "start": 33.13,
   "end": 33.89,
   "text": "Сондықтан да"
  },
  {
   "start": 33.89,
   "end": 35.35,
   "text": "біздің жеке емде жазып,"
  },
  {
   "start": 35.35,
   "end": 36.25,
   "text": "әр стилде"
  },
  {
   "start": 36.25,
   "end": 38.01,
   "text": "қандай видеолар шығатынын"
  },
  {
   "start": 38.01,
   "end": 39.54,
   "text": "байқап көруге болады."
  }
 ],
 "effects": []
}