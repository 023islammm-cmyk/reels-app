{
 "captions": [
  {
   "start": 0.1499999999999999,
   "end": 0.9300000000000002,
   "text": "Блог бастайын деп"
  },
  {
   "start": 0.9700000000000002,
   "end": 2.01,
   "text": "жүргеніме біраз болды."
  },
  {
   "start": 2.309999999999999,
   "end": 3.0900000000000003,
   "text": "Өте көп уақыт"
  },
  {
   "start": 3.1700000000000004,
   "end": 3.43,
   "text": "өтті."
  },
  {
   "start": 3.7300000000000004,
   "end": 4.99,
   "text": "Осылай ойланып, жұрттың"
  },
  {
   "start": 5.050000000000001,
   "end": 6.15,
   "text": "сөзіне қарап, біреу"
  },
  {
   "start": 6.1899999999999995,
   "end": 6.93,
   "text": "бірнәрсе деп айтып"
  },
  {
   "start": 6.949999999999999,
   "end": 7.83,
   "text": "қала ма, біреу"
  },
  {
   "start": 7.869999999999999,
   "end": 8.65,
   "text": "жаман айта ма,"
  },
  {
   "start": 8.950000000000001,
   "end": 10.03,
   "text": "ауылдағылар жек көре"
  },
  {
   "start": 10.070000000000002,
   "end": 10.830000000000004,
   "text": "ма деген секілді"
  },
  {
   "start": 10.870000000000003,
   "end": 11.690000000000003,
   "text": "неше түрлі оймен"
  },
  {
   "start": 11.990000000000004,
   "end": 13.009000000000002,
   "text": "осы блогті бастауға"
  },
  {
   "start": 13.290000000000001,
   "end": 14.090000000000005,
   "text": "қорқып жүрген едім."
  },
  {
   "start": 14.39,
   "end": 15.689999999999998,
   "text": "Бірінші қорқынышым менің"
  },
  {
   "start": 15.989999999999991,
   "end": 17.089999999999993,
   "text": "біреулер не дейді"
  },
  {
   "start": 17.109999999999996,
   "end": 17.56999999999999,
   "text": "екен ойы."
  },
  {
   "start": 17.869999999999994,
   "end": 19.20999999999998,
   "text": "Екінші қорқынышым біз"
  },
  {
   "start": 19.309999999999988,
   "end": 20.189999999999984,
   "text": "анандай идеальный"
  },
  {
   "start": 20.249999999999986,
   "end": 21.169999999999987,
   "text": "моментті күтеміз ғой."
  },
  {
   "start": 21.469999999999978,
   "end": 22.349999999999987,
   "text": "Барлығы идеальный"
  },
  {
   "start": 22.38999999999998,
   "end": 23.089999999999982,
   "text": "жасалып өту керек."
  },
  {
   "start": 23.389999999999983,
   "end": 24.149999999999974,
   "text": "Жоқ, ондай болмайды"
  },
  {
   "start": 24.169999999999984,
   "end": 24.349999999999977,
   "text": "екен."
  },
  {
   "start": 24.64999999999998,
   "end": 25.709999999999976,
   "text": "Барлығы бірден идеальный"
  },
  {
   "start": 25.749999999999975,
   "end": 26.40999999999998,
   "text": "басталмайды екен."
  },
  {
   "start": 26.70999999999998,
   "end": 27.729999999999976,
   "text": "Үшінші қорқынышым менің"
  },
  {
   "start": 28.029999999999973,
   "end": 29.60999999999997,
   "text": "өзімнің түрімнен ұялуым."
  },
  {
   "start": 29.909999999999968,
   "end": 31.449999999999974,
   "text": "Өзімнің түрім басқаларға"
  },
  {
   "start": 31.849999999999966,
   "end": 32.60999999999997,
   "text": "әдемі емес деп"
  },
  {
   "start": 32.66999999999997,
   "end": 33.68999999999997,
   "text": "мен өзім ойыммен"
  },
  {
   "start": 33.74999999999997,
   "end": 34.12999999999997,
   "text": "ойлауым."
  },
  {
   "start": 34.42999999999998,
   "end": 35.24999999999997,
   "text": "Осындай қорқыныштарды"
  },
  {
   "start": 35.32999999999997,
   "end": 35.92999999999998,
   "text": "жеңу үшін менің"
  },
  {
   "start": 35.98999999999998,
   "end": 36.809999999999974,
   "text": "осындай Инстаграм"
  },
  {
   "start": 37.10999999999998,
   "end": 37.96999999999996,
   "text": "парақшамды бастап"
  },
  {
   "start": 38.029999999999966,
   "end": 38.36999999999997,
   "text": "жатырмын."
  },
  {
   "start": 38.669999999999966,
   "end": 39.78999999999997,
   "text": "Осыны Телеграм."
  },
  {
   "start": 40.089999999999975,
   "end": 41.24999999999997,
   "text": "Осыны Инстаграмға да"
  },
  {
   "start": 41.289999999999964,
   "end": 41.64999999999998,
   "text": "саламын."
  },
  {
   "start": 41.949999999999974,
   "end": 43.04999999999996,
   "text": "Және де ТикТокқа"
  },
  {
   "start": 43.08999999999997,
   "end": 43.909999999999975,
   "text": "да салып, сіздермен"
  },
  {
   "start": 43.94999999999997,
   "end": 44.669999999999966,
   "text": "бөлісіп, сіздерден"
  },
  {
   "start": 45.04999999999996,
   "end": 45.629999999999974,
   "text": "қолдау күтемін."
  }
 ],
