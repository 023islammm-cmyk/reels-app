{
 "captions": [
  {
   "start": 0.15000000000000036,
   "end": 1.9900000000000002,
   "text": "Claude Code монтажынан үйрене"
  },
  {
   "start": 2.0500000000000007,
   "end": 2.5100000000000016,
   "text": "алмай,"
  },
  {
   "start": 2.8100000000000023,
   "end": 4.110000000000003,
   "text": "қолында ноутбугы бар,"
  },
  {
   "start": 4.4100000000000055,
   "end": 6.6700000000000035,
   "text": "барлық адамдардан скиллдарды толтырып"
  },
  {
   "start": 6.730000000000006,
   "end": 7.4100000000000055,
   "text": "тастаған,"
  },
  {
   "start": 7.710000000000001,
   "end": 9.169999999999998,
   "text": "плагиндер жалғап тастаған,"
  },
  {
   "start": 9.469999999999995,
   "end": 11.169999999999998,
   "text": "бірақ өзің түсіріп сол видеоны"
  },
  {
   "start": 11.469999999999995,
   "end": 13.129999999999988,
   "text": "мынау Claude Code-қа салып,"
  },
  {
   "start": 13.429999999999989,
   "end": 15.109999999999989,
   "text": "өзің қалағандай монтажды аламай"
  },
  {
   "start": 15.149999999999988,
   "end": 15.429999999999989,
   "text": "жүрсең,"
  },
  {
   "start": 15.729999999999986,
   "end": 16.769999999999992,
   "text": "сіздерге бір ұсыныс бар."
  },
  {
   "start": 17.069999999999986,
   "end": 19.369999999999983,
   "text": "Сіз өзіңіз обычно өзіңіздің мамандығыңыз"
  },
  {
   "start": 19.40999999999999,
   "end": 21.030999999999985,
   "text": "бойынша бір минуттық видеоңызды"
  },
  {
   "start": 21.070999999999984,
   "end": 21.590999999999987,
   "text": "дайындайсыз."
  },
  {
   "start": 21.890999999999984,
   "end": 23.850999999999992,
   "text": "Сол видеоны менің көрсетілген"
  },
  {
   "start": 23.910999999999994,
   "end": 26.29099999999999,
   "text": "Telegram ботқа жүктеп жіберсеңіз,"
  },
  {
   "start": 26.410999999999994,
   "end": 27.05099999999998,
   "text": "стилін таңдап,"
  },
  {
   "start": 27.350999999999985,
   "end": 29.650999999999982,
   "text": "сізге дайын он бес минутта"
  },
  {
   "start": 29.75099999999999,
   "end": 31.53099999999999,
   "text": "автоматтандырылған осындай сіз"
  },
  {
   "start": 31.570999999999984,
   "end": 34.090999999999994,
   "text": "көріп жатқан монтаж жасалып береді."
  },
  {
   "start": 34.390999999999984,
   "end": 35.37099999999999,
   "text": "Ешқандай промпт,"
  },
  {
   "start": 35.67099999999998,
   "end": 36.65099999999997,
   "text": "ешқандай скилл,"
  },
  {
   "start": 36.950999999999965,
   "end": 38.83099999999996,
   "text": "ешқандай бір артық құралдар қажет"
  },
  {
   "start": 38.89099999999996,
   "end": 39.29099999999997,
   "text": "емес."
  },
  {
   "start": 39.590999999999966,
   "end": 41.11099999999997,
   "text": "Тағы да бір айта кететінім,"
  },
  {
   "start": 41.21099999999996,
   "end": 42.770999999999965,
   "text": "егер мысалы өзіңіздің компанияңыздың"
  },
  {
   "start": 42.81099999999996,
   "end": 44.990999999999985,
   "text": "логотипі немесе өзіңіздің фондық"
  },
  {
   "start": 45.230999999999995,
   "end": 48.051,
   "text": "дыбыстар немесе музыкаларды өзіңіз"
  },
  {
   "start": 48.130999999999986,
   "end": 48.931,
   "text": "қойғыңыз келетін болса,"
  },
  {
   "start": 49.230999999999995,
   "end": 50.010999999999996,
   "text": "монтаждың ішінде,"
  },
  {
   "start": 50.05099999999999,
   "end": 51.43099999999998,
   "text": "бағана Telegram ботының ішінде"
  },
  {
   "start": 51.730999999999995,
   "end": 54.11099999999999,
   "text": "сол жерге өзіңіздікін қойып жасауға"
  },
  {
   "start": 54.15100000000001,
   "end": 55.67099999999999,
   "text": "мүмкіндіктеріңіз бар негізі."
  },
  {
   "start": 55.97100000000002,
   "end": 57.51100000000001,
   "text": "Сондықтан да Telegram ботты алғың"
  },
  {
   "start": 57.551,
   "end": 57.87100000000002,
   "text": "келетін,"
  },
  {
   "start": 57.931000000000026,
   "end": 59.151000000000025,
   "text": "Telegram ботпен жұмыс жасағың"
  },
  {
   "start": 59.17100000000001,
   "end": 59.75100000000002,
   "text": "келетін,"
  },
  {
   "start": 59.831,
   "end": 61.81100000000002,
   "text": "менің осындай ноутбугым жоқ,"
  },
  {
   "start": 61.87100000000002,
   "end": 63.87100000000002,
   "text": "менің осындай монтажға уақытым"
  },
  {
   "start": 63.931000000000026,
   "end": 66.15100000000004,
   "text": "жоқ деген кісілерге мен астында"
  },
  {
   "start": 66.21100000000001,
   "end": 67.91100000000003,
   "text": "Telegram ботты қалдырамын."
  },
  {
   "start": 67.97100000000003,
   "end": 70.67100000000005,
   "text": "Соған тіркеліп немесе осы видеоның"
  },
  {
   "start": 70.77100000000002,
   "end": 71.81100000000004,
   "text": "астынан лайк басып,"
  },
  {
   "start": 72.13100000000003,
   "end": 73.55100000000004,
   "text": "астынан бот сөзін жазсаңыздар,"
  },
  {
   "start": 73.85100000000004,
   "end": 75.59100000000002,
   "text": "сіздерге осындай Telegram ботты"
  },
  {
   "start": 75.65100000000002,
   "end": 77.11100000000006,
   "text": "біз сіздерге беретін боламыз."
  },
  {
   "start": 77.19100000000005,
   "end": 77.55100000000006,
   "text": "Әрине,"
  },
  {
   "start": 77.61100000000006,
   "end": 78.45100000000004,
   "text": "бұл ақылы."
  }
 ],
 "effects": []
}