{
 "captions": [
  {
   "start": 6.98,
   "end": 7.2,
   "text": "Так,"
  },
  {
   "start": 7.54,
   "end": 8.38,
   "text": "мен сіздерге бүгін"
  },
  {
   "start": 8.92,
   "end": 10.76,
   "text": "Instagram-нан алған видеоның"
  },
  {
   "start": 10.8,
   "end": 12.18,
   "text": "монтажын қалай ботпен"
  },
  {
   "start": 12.22,
   "end": 12.9,
   "text": "жасау керек дегенді"
  },
  {
   "start": 12.92,
   "end": 14.02,
   "text": "сіздерге көрсетейін деген"
  },
  {
   "start": 14.04,
   "end": 14.24,
   "text": "болдым."
  },
  {
   "start": 15.24,
   "end": 16.06,
   "text": "Бұл жерде бірінші"
  },
  {
   "start": 16.32,
   "end": 17.18,
   "text": "сол жақ бетінде"
  },
  {
   "start": 17.26,
   "end": 18.18,
   "text": "монтаждалмаған видео,"
  },
  {
   "start": 18.82,
   "end": 19.56,
   "text": "оң жақ бетінде"
  },
  {
   "start": 20.28,
   "end": 21.24,
   "text": "монтаждалған видео."
  },
  {
   "start": 22.16,
   "end": 23.48,
   "text": "Енді нәтижесін көрейік."
  },
  {
   "start": 57.58,
   "end": 57.76,
   "text": "Міне,"
  },
  {
   "start": 57.84,
   "end": 59.22,
   "text": "менің осындай ақылды"
  },
  {
   "start": 59.26,
   "end": 60.3,
   "text": "ботым өзі автоматты"
  },
  {
   "start": 60.4,
   "end": 63.38,
   "text": "түрде кинетикалық субтитрлардың"
  },
  {
   "start": 63.42,
   "end": 64.58,
   "text": "барлығын өзі қойып,"
  },
  {
   "start": 65.18,
   "end": 66.4,
   "text": "керек жеріне керек"
  },
  {
   "start": 66.46,
   "end": 67.76,
   "text": "картинкаларды белгілеп,"
  },
  {
   "start": 68.24,
   "end": 69.48,
   "text": "барлығын цифрлардың бәрін"
  },
  {
   "start": 69.54,
   "end": 70.72,
   "text": "өзі осылай әдемі"
  },
  {
   "start": 70.76,
   "end": 71.44,
   "text": "етіп осы жерге"
  },
  {
   "start": 71.5,
   "end": 72.06,
   "text": "орналастырады."
  },
  {
   "start": 72.5,
   "end": 73.52,
   "text": "Осындай Telegram ботпен"
  },
  {
   "start": 73.58,
   "end": 74.14,
   "text": "жұмыс жасаймын,"
  },
  {
   "start": 74.5,
   "end": 75.44,
   "text": "Telegram ботпен видео"
  },
  {
   "start": 75.48,
   "end": 76.44,
   "text": "монтаждаймын деген кісілер"
  },
  {
   "start": 76.46,
   "end": 76.9,
   "text": "болса,"
  },
  {
   "start": 77.4,
   "end": 78.56,
   "text": "астына \"бот\" деген"
  },
  {
   "start": 78.6,
   "end": 79.32,
   "text": "сөзді жазыңыздар."
  },
  {
   "start": 79.68,
   "end": 80.98,
   "text": "Мен сіздерге ботпен"
  },
  {
   "start": 81.02,
   "end": 81.56,
   "text": "бөлісетін болдым."
  }
