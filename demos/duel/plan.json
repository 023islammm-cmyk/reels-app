{
 "captions": [
  {
   "start": 0.15000000000000036,
   "end": 1.3099999999999987,
   "text": "Бұл видеоны монтаждау"
  },
  {
   "start": 1.3300000000000018,
   "end": 2.3500000000000014,
   "text": "үшін мен мүлде"
  },
  {
   "start": 2.3900000000000006,
   "end": 3.5100000000000016,
   "text": "ноутбукты қолданған"
  },
  {
   "start": 3.5500000000000007,
   "end": 3.7699999999999996,
   "text": "жоқпын."
  },
  {
   "start": 4.069999999999997,
   "end": 4.969999999999995,
   "text": "Көбіміз телефонға"
  },
  {
   "start": 5.029999999999994,
   "end": 5.409999999999997,
   "text": "түсіреміз,"
  },
  {
   "start": 5.809999999999995,
   "end": 6.929999999999996,
   "text": "бірақ ұмытып кетіп"
  },
  {
   "start": 6.969999999999988,
   "end": 8.20999999999999,
   "text": "жатамыз монтаждауды."
  },
  {
   "start": 8.509999999999991,
   "end": 9.269999999999996,
   "text": "Ал ноутбукпен"
  },
  {
   "start": 9.309999999999988,
   "end": 10.249999999999986,
   "text": "монтаждайық десек, оның"
  },
  {
   "start": 10.249999999999986,
   "end": 11.809999999999988,
   "text": "ішінде бағдарлама Claude"
  },
  {
   "start": 11.86999999999999,
   "end": 13.309999999999988,
   "text": "Code ноутбукқа орнату"
  },
  {
   "start": 13.329999999999984,
   "end": 13.889999999999986,
   "text": "және де оның"
  },
  {
   "start": 13.929999999999978,
   "end": 15.129999999999988,
   "text": "ішіндегі командалары,"
  },
  {
   "start": 15.229999999999983,
   "end": 16.109999999999992,
   "text": "скилл плагиндерді"
  },
  {
   "start": 16.149999999999984,
   "end": 16.569999999999986,
   "text": "орнату."
  },
  {
   "start": 16.869999999999983,
   "end": 17.52899999999999,
   "text": "Бұл көп уақыт"
  },
  {
   "start": 17.54999999999999,
   "end": 17.789999999999985,
   "text": "алады."
  },
  {
   "start": 18.089999999999982,
   "end": 18.509999999999984,
   "text": "Қараңыздар,"
  },
  {
   "start": 18.889999999999993,
   "end": 19.66999999999998,
   "text": "менің сол жағымда"
  },
  {
   "start": 19.709999999999987,
   "end": 20.229999999999983,
   "text": "шығатын бұл"
  },
  {
   "start": 20.62999999999999,
   "end": 21.569999999999986,
   "text": "монтаждалмаған видео."
  },
  {
   "start": 21.86999999999999,
   "end": 22.56999999999998,
   "text": "Ал оң жағымда"
  },
  {
   "start": 22.649999999999977,
   "end": 24.02999999999998,
   "text": "шығатын бұл ботпен"
  },
  {
   "start": 24.069999999999972,
   "end": 24.92999999999997,
   "text": "монтаждалған видео."
  },
  {
   "start": 25.229999999999976,
   "end": 26.949999999999974,
   "text": "Артығы кесілген, субтитр"
  },
  {
   "start": 27.06999999999998,
   "end": 28.14999999999999,
   "text": "қойылған және де"
  },
  {
   "start": 28.450000000000003,
   "end": 30.010000000000005,
   "text": "анимациясы бар, музыкасы"
  },
  {
   "start": 30.03,
   "end": 30.290000000000006,
   "text": "бар."
  },
  {
   "start": 30.590000000000018,
   "end": 31.770000000000024,
   "text": "Мен барлығын Telegram"
  },
  {
   "start": 31.810000000000016,
   "end": 32.43000000000002,
   "text": "ботқа жібердім."
  },
  {
   "start": 32.73000000000003,
   "end": 34.070000000000036,
   "text": "Міне, осындай нәтиже."
  },
  {
   "start": 54.37000000000006,
   "end": 55.35000000000002,
   "text": "Осындай видеоны жасау"
  },
  {
   "start": 55.37000000000006,
   "end": 56.490000000000066,
   "text": "үшін ноутбук керек"
  },
  {
   "start": 56.53000000000003,
   "end": 56.79000000000002,
   "text": "емес."
  },
  {
   "start": 57.09000000000003,
   "end": 58.25000000000006,
   "text": "Бағдарлама үйрену керек"
  },
  {
   "start": 58.29000000000008,
   "end": 58.57000000000005,
   "text": "емес."
  },
  {
   "start": 58.87000000000006,
   "end": 59.76900000000006,
   "text": "Тек телефон."
  },
  {
   "start": 60.069000000000074,
   "end": 61.2290000000001,
   "text": "Осындай видеоны түсіріп,"
  },
  {
   "start": 61.24900000000008,
   "end": 62.2890000000001,
   "text": "жасағысы келіп жатқан"
  },
  {
   "start": 62.2890000000001,
   "end": 63.589000000000084,
   "text": "адамдарға достарыңызбен"
  },
  {
   "start": 63.70900000000009,
   "end": 64.02900000000008,
   "text": "бөлісіңіз."
  }
